generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

model User {
  id           String     @id @db.VarChar(36)
  firstName    String
  lastName     String
  email        String     @unique
  status       UserStatus @default(ACTIVE)
  gender       Gender
  phone        String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  isBlocked    Boolean    @default(false)
  role         Role       @default(USER)
  passwordHash String
}
