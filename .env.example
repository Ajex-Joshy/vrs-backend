# Server
NODE_ENV=development
PORT=3000

# Auth
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=1d

# MySQL (Prisma)
MYSQL_DATABASE_URL="mysql://root:password@localhost:3306/vehicle_rental"

# MongoDB (Mongoose logs)
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="vehicle_rental_logs"

# Seed users
SEED_ADMIN_EMAIL=admin@vrs.local
SEED_ADMIN_PASSWORD=Admin@1234
SEED_USER_EMAIL=user@vrs.local
SEED_USER_PASSWORD=User@1234

# Smoke test
SMOKE_BASE_URL=http://127.0.0.1:3000
